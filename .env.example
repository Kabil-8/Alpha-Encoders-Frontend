# Alpha Encoders Frontend Environment
# In production on Vercel: set to https://alpha-encoders-backend.onrender.com (or leave blank to use vercel.json rewrites)
# In local development: http://localhost:5000 (or leave blank to use Vite dev proxy)
VITE_API_URL=https://alpha-encoders-backend.onrender.com
VITE_SITE_URL=https://alphaencoders.vercel.app

# Google OAuth 2.0 Web Client ID
# Provide your client ID from Google Cloud Console -> APIs & Services -> Credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
